{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "buildCommand": "cd stock-analysis-frontend && npm install && npm run build",
  "outputDirectory": "stock-analysis-frontend/build",
  "framework": "create-react-app",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./"
}
